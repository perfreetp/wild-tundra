    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "puppeteer": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
