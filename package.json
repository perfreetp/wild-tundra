{
  "name": "railview-compositor",
  "version": "1.0.0",
  "private": true,
  "description": "列车驾驶视景多图层合成工具（TypeScript + Web Components + three.js + postprocessing）",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
